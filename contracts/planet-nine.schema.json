{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:planet-x-spherex:planet-nine:1",
  "title": "Planet Nine conditional hypothesis, coverage and restricted gravity contracts",
  "description": "Separate from immutable legacy observation OpenAPI. No detection, discovery or all-physics claim is permitted by this contract.",
  "x-contract-version": "planet-nine-contract-1",
  "x-endpoints": {
    "GET /api/v1/planet-nine/presets": {
      "response": "Presets"
    },
    "POST /api/v1/planet-nine/predict": {
      "request": "PredictionInput",
      "response": "Prediction"
    },
    "POST /api/v1/planet-nine/gravity-field": {
      "request": "GravityFieldInput",
      "response": "GravityFieldResult"
    },
    "POST /api/v1/planet-nine/integrate": {
      "request": "IntegrationInput",
      "response": "IntegrationResult"
    },
    "POST /api/v1/planet-nine/coverage": {
      "request": "CoverageInput",
      "response": "Coverage"
    },
    "POST /api/v1/planet-nine/evidence": {
      "request": "EvidenceRequest",
      "response": "EvidenceEnvelope",
      "status": 201
    },
    "GET /api/v1/planet-nine/evidence/{evidence_id}/export": {
      "response": "EvidenceEnvelope"
    },
    "POST /api/v1/planet-nine/evidence/import": {
      "request": "EvidenceEnvelope",
      "response": "RestoreResponse"
    },
    "GET /api/v1/catalog/outer-tno": {
      "response": "OuterCatalogue"
    },
    "GET /api/v1/catalog/outer-tno/scene": {
      "response": "OuterScene"
    },
    "GET /api/v1/catalog/outer-tno/object": {
      "response": "OuterObject"
    }
  },
  "$defs": {
    "Orbit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a_au",
        "e",
        "i_deg",
        "omega_deg",
        "Omega_deg",
        "M_deg",
        "epoch_jd_tdb"
      ],
      "properties": {
        "a_au": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2000
        },
        "e": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "i_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "omega_deg": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000,
          "description": "Argument of perihelion; source varpi requires subtraction of Omega."
        },
        "Omega_deg": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "M_deg": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "epoch_jd_tdb": {
          "$ref": "#/$defs/JulianDay"
        },
        "mass_earth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "description": "Hypothetical source strength; not used in its own massless test-particle trajectory."
        }
      }
    },
    "JulianDay": {
      "type": "number",
      "minimum": 625697.5,
      "maximum": 2816787.5
    },
    "Vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "PredictionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orbit",
        "start_jd_tdb",
        "end_jd_tdb"
      ],
      "$comment": "Runtime also enforces start<=end, interval<=36525 days and light-time emission date in range.",
      "properties": {
        "orbit": {
          "$ref": "#/$defs/Orbit"
        },
        "start_jd_tdb": {
          "$ref": "#/$defs/JulianDay"
        },
        "end_jd_tdb": {
          "$ref": "#/$defs/JulianDay"
        },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256,
          "default": 64
        },
        "observer": {
          "type": "string",
          "enum": [
            "earth_moon_barycenter",
            "sun"
          ],
          "default": "earth_moon_barycenter"
        }
      }
    },
    "Prediction": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "algorithm_version",
        "status",
        "request",
        "orbit",
        "path",
        "coordinate_frame",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "algorithm_version": {
          "type": "string"
        },
        "status": {
          "const": "conditional_hypothesis"
        },
        "request": {
          "$ref": "#/$defs/PredictionInput"
        },
        "orbit": {
          "$ref": "#/$defs/Orbit"
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "type": "object"
          }
        },
        "coordinate_frame": {
          "const": "mean_equatorial_J2000_IAU1976_rotation_approximation"
        },
        "assumptions": {
          "type": "object",
          "required": [
            "measured_motion",
            "discovery_claim"
          ],
          "properties": {
            "measured_motion": {
              "const": false
            },
            "discovery_claim": {
              "const": false
            }
          }
        },
        "limitations": {
          "$ref": "#/$defs/Limitations"
        }
      }
    },
    "GravityFieldInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_au",
        "jd_tdb"
      ],
      "$comment": "Velocity is required for optional solar1PN. Near-source singularities, field domain and source cutoffs are checked in the calculator.",
      "properties": {
        "position_au": {
          "$ref": "#/$defs/Vector3"
        },
        "jd_tdb": {
          "$ref": "#/$defs/JulianDay"
        },
        "velocity_au_day": {
          "$ref": "#/$defs/Vector3"
        },
        "hypothesis": {
          "$ref": "#/$defs/Orbit"
        },
        "include_planets": {
          "type": "boolean",
          "default": true
        },
        "include_solar_gr_1pn": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "IntegrationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orbit",
        "start_jd_tdb"
      ],
      "$comment": "Runtime additionally enforces perihelion>=35AU, max4096 coarse steps plus halfstep comparison, max2500ms and trajectory domain. 1000AU is not a force cutoff.",
      "properties": {
        "orbit": {
          "$ref": "#/$defs/Orbit"
        },
        "start_jd_tdb": {
          "$ref": "#/$defs/JulianDay"
        },
        "hypothesis": {
          "$ref": "#/$defs/Orbit"
        },
        "duration_days": {
          "type": "number",
          "minimum": -14610,
          "maximum": 14610,
          "default": 3652.5,
          "description": "Zero duration is rejected by runtime."
        },
        "step_days": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 4,
          "default": 1
        },
        "include_planets": {
          "type": "boolean",
          "default": true
        },
        "include_solar_gr_1pn": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "GravityFieldResult": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "algorithm_version",
        "status",
        "request",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "algorithm_version": {
          "type": "string"
        },
        "status": {
          "const": "conditional_gravity_model"
        },
        "request": {
          "$ref": "#/$defs/GravityFieldInput"
        },
        "limitations": {
          "$ref": "#/$defs/Limitations"
        }
      }
    },
    "IntegrationResult": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "algorithm_version",
        "status",
        "request",
        "limitations",
        "force_model",
        "integrator",
        "convergence",
        "energy"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "algorithm_version": {
          "type": "string"
        },
        "status": {
          "const": "conditional_trajectory"
        },
        "request": {
          "$ref": "#/$defs/IntegrationInput"
        },
        "limitations": {
          "$ref": "#/$defs/Limitations"
        },
        "force_model": {
          "type": "object"
        },
        "integrator": {
          "type": "object"
        },
        "convergence": {
          "type": "object"
        },
        "energy": {
          "type": "object"
        }
      }
    },
    "CoverageDate": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
      "description": "Validated UTC calendar date2025..2030. Inclusive query range cannot exceed31 calendar days."
    },
    "CoverageInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orbit",
            "start_date",
            "end_date"
          ],
          "properties": {
            "orbit": {
              "$ref": "#/$defs/Orbit"
            },
            "start_date": {
              "$ref": "#/$defs/CoverageDate"
            },
            "end_date": {
              "$ref": "#/$defs/CoverageDate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "known_object",
            "start_date",
            "end_date"
          ],
          "properties": {
            "known_object": {
              "const": "pluto"
            },
            "start_date": {
              "$ref": "#/$defs/CoverageDate"
            },
            "end_date": {
              "$ref": "#/$defs/CoverageDate"
            }
          }
        }
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "coverage_id",
        "status",
        "query",
        "queried_at",
        "cache_hit",
        "response_sha256",
        "raw_response",
        "rows",
        "row_count",
        "observer",
        "claim",
        "error",
        "source_url",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "p9-coverage-1"
        },
        "coverage_id": {
          "type": "string",
          "pattern": "^p9cov_[a-f0-9]{24}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "coverage_available",
            "no_coverage",
            "service_error"
          ]
        },
        "query": {
          "type": "object",
          "required": [
            "catalog",
            "input_type",
            "obs_begin",
            "obs_end",
            "output_mode"
          ],
          "properties": {
            "catalog": {
              "const": "spherex"
            },
            "output_mode": {
              "const": "Brief"
            },
            "input_type": {
              "type": "string",
              "enum": [
                "manual_input",
                "naifid_input"
              ]
            },
            "obs_begin": {
              "type": "string"
            },
            "obs_end": {
              "type": "string"
            }
          }
        },
        "queried_at": {
          "type": "string",
          "format": "date-time"
        },
        "cache_hit": {
          "type": "boolean"
        },
        "response_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_response": {
          "type": "string",
          "maxLength": 2000000,
          "description": "SHA256 is over decoded UTF8 body bytes, not HTTP wire/compressed bytes."
        },
        "response_metadata": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "rows": {
          "type": "array",
          "maxItems": 2500,
          "items": {
            "type": "object"
          }
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2500
        },
        "observer": {
          "const": "MOST_observer_not_verified"
        },
        "claim": {
          "const": "predicted_footprint_overlap_only"
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "source_url": {
          "const": "https://irsa.ipac.caltech.edu/cgi-bin/MOST/nph-most"
        },
        "limitations": {
          "$ref": "#/$defs/Limitations"
        }
      }
    },
    "PresetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_id",
        "row_index",
        "source_sha256"
      ],
      "$comment": "Runtime verifies ID/index mapping, current sourceSHA and exact normalized orbit against the selected original row.",
      "properties": {
        "preset_id": {
          "type": "string",
          "pattern": "^caltech-row-[0-9]{1,5}$"
        },
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "GravityRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "result"
          ],
          "properties": {
            "kind": {
              "const": "field"
            },
            "result": {
              "$ref": "#/$defs/GravityFieldResult"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "result"
          ],
          "properties": {
            "kind": {
              "const": "integration"
            },
            "result": {
              "$ref": "#/$defs/IntegrationResult"
            }
          }
        }
      ]
    },
    "RegionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subset",
        "max_reference_distance_au",
        "cell_id",
        "row_index"
      ],
      "properties": {
        "subset": {
          "enum": [
            "all",
            "ztf",
            "ztf_des",
            "ztf_des_ps1"
          ]
        },
        "max_reference_distance_au": {
          "enum": [
            null,
            1000
          ]
        },
        "cell_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12287
        },
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        }
      },
      "$comment": "Server revalidates source-epoch HEALPix membership and survey/distance filters. This never changes the literature distribution when a hypothesis orbit is edited."
    },
    "EvidenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orbit",
        "prediction",
        "judgment",
        "locale"
      ],
      "$comment": "Save/import enforce the common UI date selection: MOST obs_begin/end UTC calendar labels must equal prediction start/end assumed-TDB calendar labels, without claiming a precise UTC/TDB conversion. Gravity field jd_tdb or integration start_jd_tdb must equal prediction start_jd_tdb. Stored original exports are preserved without rewriting old envelopes.",
      "properties": {
        "orbit": {
          "$ref": "#/$defs/Orbit"
        },
        "prediction": {
          "$ref": "#/$defs/Prediction"
        },
        "coverage": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Coverage"
            }
          ]
        },
        "gravity": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/GravityRecord"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/PresetReference"
            }
          ]
        },
        "region_context": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/RegionContext"
            }
          ]
        },
        "judgment": {
          "type": "string",
          "maxLength": 12000
        },
        "locale": {
          "type": "string",
          "enum": [
            "ko",
            "en",
            "ja",
            "zh-Hant",
            "fr"
          ]
        }
      }
    },
    "EvidenceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "evidence_id",
        "created_at",
        "payload",
        "payload_sha256",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "planet-nine-evidence-1"
        },
        "kind": {
          "const": "planet_nine_hypothesis_coverage"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^p9ev_[a-f0-9]{32}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/EvidenceRequest"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "limitations": {
          "$ref": "#/$defs/Limitations"
        }
      }
    },
    "RestoreResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "restored",
            "recalculation_required"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceEnvelope"
        }
      }
    },
    "Presets": {
      "type": "object",
      "required": [
        "schema_version",
        "source",
        "presets",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "source": {
          "type": "object",
          "required": [
            "sha256",
            "path",
            "bytes",
            "epoch_jd_raw",
            "epoch_discrepancy"
          ]
        },
        "presets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "row_index",
              "orbit"
            ],
            "properties": {
              "orbit": {
                "$ref": "#/$defs/Orbit"
              }
            }
          }
        },
        "limitations": {
          "$ref": "#/$defs/Limitations"
        }
      }
    },
    "RegionQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subset": {
          "enum": [
            "all",
            "ztf",
            "ztf_des",
            "ztf_des_ps1"
          ],
          "default": "ztf_des_ps1"
        },
        "max_reference_distance_au": {
          "enum": [
            null,
            1000
          ],
          "default": 1000
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "description": "GET /planet-nine/regions. Filters apply to raw 2018 author RA/Dec and heliocentric R, not a newly propagated population."
    },
    "RegionPage": {
      "type": "object",
      "required": [
        "schema_version",
        "algorithm_version",
        "source",
        "selection",
        "nside",
        "ordering",
        "rows",
        "next_offset",
        "existence_probability"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "nside": {
          "const": 32
        },
        "ordering": {
          "const": "RING"
        },
        "existence_probability": {
          "type": "null"
        },
        "rows": {
          "type": "array",
          "maxItems": 100
        },
        "samples": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/PopulationSampleSummary"
          },
          "description": "Same page length and order as rows, joined by row_index; all values are copied from the original synthetic population."
        }
      }
    },
    "PopulationRow": {
      "type": "object",
      "required": [
        "id",
        "row_index",
        "orbit",
        "source_columns",
        "source_sha256",
        "cell_id",
        "individual_existence_probability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^caltech-row-[0-9]{1,5}$"
        },
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "orbit": {
          "$ref": "#/$defs/Orbit"
        },
        "individual_existence_probability": {
          "type": "null"
        }
      }
    },
    "OuterCatalogue": {
      "type": "object",
      "required": [
        "algorithm_version",
        "source_algorithm_version",
        "source",
        "selection",
        "objects",
        "reference_jd_tdb",
        "study_radius_au",
        "propagation_operating_limit_days",
        "extrapolation_warning_after_days",
        "supported_calendar",
        "warning_threshold_definition"
      ],
      "properties": {
        "algorithm_version": {
          "const": "jpl-sbdb-tno-two-body-v2"
        },
        "source_algorithm_version": {
          "const": "jpl-sbdb-tno-two-body-v1"
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "object_id",
              "name",
              "orbit_status",
              "reference_radius_au"
            ]
          }
        },
        "study_radius_au": {
          "const": 1000
        },
        "propagation_operating_limit_days": {
          "type": "null"
        },
        "extrapolation_warning_after_days": {
          "const": 36525
        },
        "supported_calendar": {
          "$ref": "#/$defs/OuterSupportedCalendar"
        },
        "warning_threshold_definition": {
          "const": "display_warning_only_not_an_ephemeris_validity_interval"
        }
      },
      "description": "GET /catalog/outer-tno: unchanged dated JPL class-TNO source snapshot with a separately versioned runtime. Full model-calendar propagation is an unvalidated solar Kepler extrapolation, not a precise ephemeris. The100-Julian-year threshold only triggers a warning. Null physical measurements remain null."
    },
    "OuterSupportedCalendar": {
      "type": "object",
      "required": [
        "min_year",
        "max_year",
        "min_jd_tdb",
