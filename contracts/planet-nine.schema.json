        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session": {
          "type": "object"
        },
        "comparison": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "judgment": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^ev_[a-f0-9]{32}$"
