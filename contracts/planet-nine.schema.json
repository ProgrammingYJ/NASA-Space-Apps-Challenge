    "OuterScene": {
      "type": "object",
      "required": [
        "algorithm_version",
        "source_algorithm_version",
        "jd_tdb",
        "catalogue_count",
        "plotted_count",
        "unavailable_count",
        "outside_1000_au_count",
        "extrapolated_count",
        "extrapolated_plotted_count",
        "objects",
        "propagation_operating_limit_days",
        "extrapolation_warning_after_days",
        "supported_calendar",
        "warning_threshold_definition"
      ],
      "properties": {
        "algorithm_version": {
          "const": "jpl-sbdb-tno-two-body-v2"
        },
        "source_algorithm_version": {
          "const": "jpl-sbdb-tno-two-body-v1"
        },
        "jd_tdb": {
          "$ref": "#/$defs/JulianDay"
        },
        "catalogue_count": {
          "type": "integer",
          "minimum": 0
        },
        "plotted_count": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_count": {
          "type": "integer",
          "minimum": 0
        },
        "outside_1000_au_count": {
          "type": "integer",
          "minimum": 0
        },
        "extrapolated_count": {
          "type": "integer",
          "minimum": 0
        },
        "extrapolated_plotted_count": {
          "type": "integer",
          "minimum": 0
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OuterScenePoint"
          }
        },
        "propagation_operating_limit_days": {
          "type": "null"
        },
        "extrapolation_warning_after_days": {
          "const": 36525
        },
        "supported_calendar": {
          "$ref": "#/$defs/OuterSupportedCalendar"
        },
        "warning_threshold_definition": {
          "const": "display_warning_only_not_an_ephemeris_validity_interval"
        }
      },
      "$comment": "Runtime invariant: plotted_count + outside_1000_au_count + unavailable_count = catalogue_count; extrapolated_plotted_count <= extrapolated_count. Source-epoch distance over36525 days marks the state unvalidated and does not remove it. Outside1000AU counts selected-date distance exclusions separately from absent source elements.",
      "description": "GET /catalog/outer-tno/scene?jd_tdb=: selected-date geometric solar Kepler positions for the full model calendar. Beyond100 Julian years from each source epoch, position_status=unvalidated_kepler_extrapolation. No historical reconstruction, measured sky position, propagated uncertainty, or long-term accuracy claim."
    },
    "OuterObject": {
      "type": "object",
      "required": [
        "algorithm_version",
        "source_algorithm_version",
        "object_id",
        "jd_tdb",
        "position_au",
        "radius_au",
        "position_status",
        "within_1000_au",
        "long_range_extrapolation",
        "epoch_offset_days",
        "full_orbit_au",
        "full_orbit_clipped_at_1000_au"
      ],
      "properties": {
        "algorithm_version": {
          "const": "jpl-sbdb-tno-two-body-v2"
        },
        "source_algorithm_version": {
          "const": "jpl-sbdb-tno-two-body-v1"
        },
        "object_id": {
          "type": "string",
          "pattern": "^sbdb-[0-9]+$"
        },
        "jd_tdb": {
          "$ref": "#/$defs/JulianDay"
        },
        "position_au": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vector3"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius_au": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "within_1000_au": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "position_status": {
          "enum": [
            "osculating_two_body_prediction",
            "unvalidated_kepler_extrapolation",
            "missing_or_unsupported_elements"
          ]
        },
        "long_range_extrapolation": {
          "type": "boolean"
        },
        "epoch_offset_days": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "full_orbit_au": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 257,
              "maxItems": 257,
              "items": {
                "$ref": "#/$defs/Vector3"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "full_orbit_clipped_at_1000_au": {
          "const": false
        },
        "info": {
          "$ref": "#/$defs/OuterInformation"
        }
      },
      "description": "GET /catalog/outer-tno/object?object_id=&jd_tdb=: original source row plus selected-date state and full instantaneous osculating ellipse. The selected state remains available outside1000AU; absent elements remain null. New Node responses also provide source-bound info facts. The additive field remains optional in this shared legacy-compatible schema; when present it must satisfy OuterInformation. Runtime/source orbit algorithm versions are unchanged."
    },
    "SolarRestoreResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_schema_version",
        "status",
        "restoration_scope",
