  "components": {
    "schemas": {
      "CameraState": {
        "properties": {
          "position": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Position"
          },
          "target": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Target"
          },
          "representation_version": {
            "type": "string",
            "const": "solar-display-v1",
            "title": "Representation Version",
            "default": "solar-display-v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "position",
          "target"
        ],
        "title": "CameraState"
      },
      "ComparisonRequest": {
        "properties": {
          "observation_ids": {
            "items": {
              "type": "string",
              "enum": [
                "S01",
                "S02",
                "S12",
                "S14"
              ]
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Observation Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observation_ids"
        ],
        "title": "ComparisonRequest"
      },
      "Evidence": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version"
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^ev_[a-f0-9]{32}$",
            "title": "Evidence Id"
          },
          "created_at": {
            "type": "string",
            "maxLength": 64,
            "title": "Created At"
          },
          "result_id": {
            "type": "string",
            "pattern": "^cmp_[a-f0-9]{24}$",
            "title": "Result Id"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "judgment": {
            "type": "string",
            "maxLength": 8000,
            "title": "Judgment"
          },
          "comparison": {
            "additionalProperties": true,
            "type": "object",
            "title": "Comparison"
          },
          "comparison_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Comparison Sha256"
          },
          "ai_assistance": {
            "type": "string",
            "title": "Ai Assistance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "evidence_id",
          "created_at",
          "result_id",
          "session",
          "judgment",
          "comparison",
          "comparison_sha256",
          "ai_assistance"
        ],
        "title": "Evidence"
      },
      "EvidenceRequest": {
        "properties": {
          "result_id": {
            "type": "string",
            "pattern": "^cmp_[a-f0-9]{24}$",
            "title": "Result Id"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "judgment": {
            "type": "string",
            "maxLength": 8000,
            "title": "Judgment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "result_id",
          "session",
          "judgment"
        ],
        "title": "EvidenceRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Session": {
        "properties": {
          "object_id": {
            "type": "string",
            "enum": [
              "epsilon-indi-b",
              "pluto"
            ],
            "title": "Object Id",
            "default": "epsilon-indi-b"
          },
          "observation_ids": {
            "items": {
              "type": "string",
              "enum": [
                "S01",
                "S02",
                "S12",
                "S14"
              ]
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Observation Ids"
          },
          "active_frame": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ],
            "title": "Active Frame",
            "default": "A"
          },
          "view_mode": {
            "type": "string",
            "enum": [
              "split",
              "blink"
            ],
            "title": "View Mode",
            "default": "split"
          },
          "contrast": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.1,
            "title": "Contrast",
            "default": 1
          },
          "locale": {
            "type": "string",
            "enum": [
              "ko",
              "en",
              "ja",
              "zh-Hant",
              "fr"
            ],
            "title": "Locale",
            "default": "ko"
          },
          "universe_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UniverseContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observation_ids"
        ],
        "title": "Session"
      },
      "SimulationContext": {
        "properties": {
          "algorithm_version": {
            "type": "string",
            "const": "jpl-kepler-long-term-v1",
            "title": "Algorithm Version"
          },
          "source_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Manifest Sha256"
          },
          "model_calendar_ms": {
            "type": "number",
            "maximum": 8640000000000000.0,
            "minimum": -8640000000000000.0,
            "title": "Model Calendar Ms"
          },
          "playback_rate_hours_per_second": {
            "type": "integer",
            "enum": [
              72,
              8766,
