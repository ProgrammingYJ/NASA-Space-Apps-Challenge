  "components": {
    "schemas": {
      "CameraState": {
        "properties": {
          "position": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Position"
          },
          "target": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Target"
          },
          "representation_version": {
            "type": "string",
            "const": "solar-display-v1",
            "title": "Representation Version",
            "default": "solar-display-v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "position",
          "target"
        ],
        "title": "CameraState"
      },
      "ComparisonRequest": {
        "properties": {
          "observation_ids": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Observation Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observation_ids"
        ],
        "title": "ComparisonRequest"
      },
      "DistanceView": {
        "properties": {
          "algorithm_version": {
            "type": "string",
            "enum": [
              "solar-overview-common-v2",
              "parent-linear-distance-v1",
              "legacy-expanded-v1"
            ],
            "title": "Algorithm Version"
          },
          "origin_object_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin Object Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "algorithm_version"
        ],
        "title": "DistanceView"
      },
      "Evidence": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version"
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^ev_[a-f0-9]{32}$",
            "title": "Evidence Id"
          },
          "created_at": {
            "type": "string",
            "maxLength": 64,
            "title": "Created At"
          },
          "result_id": {
            "type": "string",
            "pattern": "^cmp_[a-f0-9]{24}$",
            "title": "Result Id"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "judgment": {
            "type": "string",
            "maxLength": 8000,
            "title": "Judgment"
          },
          "comparison": {
            "additionalProperties": true,
            "type": "object",
            "title": "Comparison"
          },
          "comparison_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Comparison Sha256"
          },
          "ai_assistance": {
            "type": "string",
            "title": "Ai Assistance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "evidence_id",
          "created_at",
          "result_id",
          "session",
          "judgment",
          "comparison",
          "comparison_sha256",
          "ai_assistance"
        ],
        "title": "Evidence"
      },
      "EvidenceRequest": {
        "properties": {
          "result_id": {
            "type": "string",
            "pattern": "^cmp_[a-f0-9]{24}$",
            "title": "Result Id"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "judgment": {
            "type": "string",
            "maxLength": 8000,
            "title": "Judgment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "result_id",
          "session",
          "judgment"
        ],
        "title": "EvidenceRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MassScenarioInput": {
        "properties": {
          "target_id": {
            "type": "string",
            "enum": [
              "sedna",
              "eris",
              "makemake",
              "quaoar",
              "orcus",
              "gonggong"
            ],
            "title": "Target Id"
          },
          "density_kg_m3": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": 100.0,
            "title": "Density Kg M3"
          },
          "analogue_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "tethys",
                  "dione",
                  "rhea",
                  "iapetus",
                  "ariel",
                  "umbriel"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Analogue Id"
          },
          "include_source_ranges": {
            "type": "boolean",
            "title": "Include Source Ranges",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_id",
          "density_kg_m3"
        ],
        "title": "MassScenarioInput"
      },
      "ObserverExperiment": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "catalogue_camera",
              "black_hole_local"
            ],
            "title": "Mode",
            "default": "catalogue_camera"
          },
          "radial_beta": {
            "type": "number",
            "maximum": 0.99,
            "minimum": -0.99,
            "title": "Radial Beta",
            "default": 0
          },
          "emitted_wavelength_nm": {
            "type": "number",
            "maximum": 1000000000.0,
            "minimum": 0.001,
            "title": "Emitted Wavelength Nm",
            "default": 550
          },
          "cosmological_enabled": {
            "type": "boolean",
            "title": "Cosmological Enabled",
            "default": true
          },
          "gravitational_enabled": {
            "type": "boolean",
            "title": "Gravitational Enabled",
            "default": false
          },
          "emitter_radius_rs": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 1.01,
            "title": "Emitter Radius Rs",
            "default": 6
          },
          "local_observer_radius_rs": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 1.01,
            "title": "Local Observer Radius Rs",
            "default": 20
          },
          "local_observer_azimuth_rad": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Local Observer Azimuth Rad",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ObserverExperiment"
      },
      "Session": {
        "properties": {
          "object_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Object Id",
            "default": "epsilon-indi-b"
          },
          "observation_ids": {
            "items": {
              "type": "string",
              "maxLength": 64,
