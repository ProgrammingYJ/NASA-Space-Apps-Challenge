# Copy to .env for local development. Never put secrets in VITE_* variables.
# Node.js startup: node app.js (or npm start). Set these in the server panel.
# The Node runtime uses environment variables; copying this file does not load it.
# Node >=22.17 can use: node --env-file=.env app.js
# Legacy Python state remains separate unless explicitly migrated after shutdown.
APP_STATE_DIR=./var/node
PORT=3002
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3002
APP_PUBLIC_URL=https://nasaspaceappschallenge.marulee.dev
API_PREFIX=/api/v1
VITE_API_BASE_URL=/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://nasaspaceappschallenge.marulee.dev"]
DATA_ROOT=./data
RAW_DATA_DIR=./data/raw
CALIBRATION_DATA_DIR=./data/calibration
REFERENCE_DATA_DIR=./data/reference
DERIVED_DATA_DIR=./data/derived
DATA_MANIFEST_PATH=./data/manifests/datasets.json
CACHE_DIR=./var/cache
JOBS_DIR=./var/jobs
EVIDENCE_DIR=./var/evidence
LOG_DIR=./var/logs
WORKER_CONCURRENCY=1
DOWNLOAD_CONCURRENCY=2
ARCHIVE_TIMEOUT_SECONDS=60
DOWNLOAD_TIMEOUT_SECONDS=180
DOWNLOAD_MAX_BYTES=134217728
DOWNLOAD_RETRY_ATTEMPTS=2
STORAGE_BACKEND=files
LOG_LEVEL=INFO
DEFAULT_LOCALE=ko
SUPPORTED_LOCALES=ko,en,ja,zh-Hant,fr
DISPLAY_TIMEZONE=Asia/Seoul
ENABLE_HIPS_BACKGROUND=false
ENABLE_EXOPLANET_MODEL=false
ENABLE_PUBLIC_SCENARIO_SHARING=false
TEAM_DATA_DRIVE_FOLDER_ID=1J065qY_U-Eb_bmOauJH4S4CeRN7KTQPS
PROJECT_REPOSITORY_URL=https://github.com/ProgrammingYJ/NASA-Space-Apps-Challenge

