[Unit]
Description=Planet X and SPHEREx Node runtime
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=planetx
Group=planetx
WorkingDirectory=/srv/planet-x/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/planet-x/app.env
ExecStart=/usr/local/lib/planet-x-node/bin/node /srv/planet-x/current/app.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/planet-x/shared
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitNOFILE=4096
TasksMax=256

[Install]
WantedBy=multi-user.target
